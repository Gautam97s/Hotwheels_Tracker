# Backend Configuration
# Copy this to .env and fill in your values

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Your delivery pincode (affects stock availability)
DEFAULT_PINCODE=110001

# Product name
PRODUCT_NAME=Hot Wheels Premium Fast & Furious Die-Cast Toy Car (Orange)

# Product URLs for each platform (get from "Find Cars" in frontend)
BLINKIT_URL=https://blinkit.com/product/...
ZEPTO_URL=https://www.zepto.com/...
FIRSTCRY_URL=https://www.firstcry.com/hot-wheels/hot-wheels-premium-fast-and-furious-die-cast-toy-car-for-adult-collectors-orange/21161951/product-detail
AMAZON_URL=https://www.amazon.in/dp/...

# Optional: GitHub token for pushing status (auto-provided in Actions)
# GITHUB_TOKEN=ghp_xxxxx